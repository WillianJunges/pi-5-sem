NODE_ENV=development
PORT=3333
# Fuso usado para saber qual é o "cardápio de hoje"
APP_TIMEZONE=America/Sao_Paulo

# Banco de dados (mesmos valores do .env da raiz, usado pelo docker-compose)
DB_HOST=localhost
DB_PORT=3306
DB_USER=marmitaria
DB_PASSWORD=marmitaria
DB_NAME=marmitaria

# MongoDB (banco não relacional / desnormalizado). Deixe vazio para desligar.
MONGO_URL=mongodb://localhost:27017/marmitaria

# Autenticação
# Gere um segredo com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=troque-este-segredo
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

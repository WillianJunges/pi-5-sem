{
  "expo": {
    "name": "Marmitaria",
    "slug": "marmitaria",
    "scheme": "marmitaria",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sua localização é compartilhada com o cliente durante entregas em andamento.",
          "locationAlwaysAndWhenInUsePermission": "Permita compartilhar sua localização durante entregas em andamento, inclusive com a tela bloqueada.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4c4a6be5-7bf7-439f-92bc-5be25d833d24"
      }
    }
  }
}
